# Copia este archivo a .env y llena los valores reales. NUNCA subas .env.
# Este .env.example SÍ se sube: documenta qué variables necesita el proyecto.

# Genera una con: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-por-una-clave-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# URL base para links absolutos del admin de Wagtail (previews, correos).
# En producción: https://ritenterprise.com.co
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Postgres local (compose.yaml, puerto 5433). Descomenta al levantar el contenedor:
# DATABASE_URL=postgres://rit:rit@localhost:5433/rit_website

# Staging sin nginx: True para que Django sirva /media/ (uploads del admin).
# En producción dejalo en False y serví /media/ con nginx o S3.
DJANGO_SERVE_MEDIA=False

# Orígenes confiables para CSRF detrás de proxy (separados por coma).
# En staging/prod: DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.ritenterprise.com,https://ritenterprise.com.co

# --- SEO ---
# Solo produccion indexa. Local y staging quedan en False (robots.txt bloquea
# todo y se envia X-Robots-Tag: noindex).
SEO_INDEXABLE=False

# URL publica canonica: canonical, hreflang, Open Graph y JSON-LD.
SITE_URL=http://localhost:8000
